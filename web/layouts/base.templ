package layouts

templ Base(title string) {
	<!DOCTYPE html>
	<html lang="sv">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<meta name="color-scheme" content="light dark"/>
			<link rel="stylesheet" href="/static/css/pico.min.css"/> <!-- 2.1.1 -->
			<link rel="stylesheet" href="/static/css/style.css"/>
			<script defer src="/static/js/htmx.min.js"></script> <!-- 4.0.0 -->
			<script defer src="/static/js/theme-switcher.js"></script>
			<script defer src="/static/js/modal.js"></script>
			<script defer src="/static/js/script.js"></script>
			<title>{ title }</title>
		</head>
		<body>
			<aside class="sidebar">
				<a href="/"><h1>korturl</h1></a>
				<nav>
					<ul>
						<li><a href="/" class="contrast"><strong>Översikt</strong></a></li>
						<li><a href="#" class="contrast"><strong>Länkar</strong></a></li>
						<li><a href="/shorten" class="contrast"><strong>Skapa länk</strong></a></li>
						<li><a href="#" class="contrast"><strong>Användare</strong></a></li>
					</ul>
					<ul>
						<li>
							<details class="dropdown">
								<summary role="button" class="outline contrast">
									<span>Tema</span>
									<svg xmlns="http://www.w3.org/2000/svg" height="20" width="20" aria-hidden="true" viewBox="0 0 640 640">
										<!--!Font Awesome Free v7.3.1 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free Copyright 2026 Fonticons, Inc.-->
										<path d="M576 320C576 320.9 576 321.8 576 322.7C575.6 359.2 542.4 384 505.9 384L408 384C381.5 384 360 405.5 360 432C360 435.4 360.4 438.7 361 441.9C363.1 452.1 367.5 461.9 371.8 471.8C377.9 485.6 383.9 499.3 383.9 513.8C383.9 545.6 362.3 574.5 330.5 575.8C327 575.9 323.5 576 319.9 576C178.5 576 63.9 461.4 63.9 320C63.9 178.6 178.6 64 320 64C461.4 64 576 178.6 576 320zM192 352C192 334.3 177.7 320 160 320C142.3 320 128 334.3 128 352C128 369.7 142.3 384 160 384C177.7 384 192 369.7 192 352zM192 256C209.7 256 224 241.7 224 224C224 206.3 209.7 192 192 192C174.3 192 160 206.3 160 224C160 241.7 174.3 256 192 256zM352 160C352 142.3 337.7 128 320 128C302.3 128 288 142.3 288 160C288 177.7 302.3 192 320 192C337.7 192 352 177.7 352 160zM448 256C465.7 256 480 241.7 480 224C480 206.3 465.7 192 448 192C430.3 192 416 206.3 416 224C416 241.7 430.3 256 448 256z"></path>
									</svg>
								</summary>
								<ul>
									<li><a data-theme-switcher="auto">Auto</a></li>
									<li><a data-theme-switcher="light">Light</a></li>
									<li><a data-theme-switcher="dark">Dark</a></li>
								</ul>
							</details>
						</li>
						<li><a role="button" href="/logout" class="logout contrast">Logga ut</a></li>
					</ul>
				</nav>
			</aside>
			<main class="container-fluid">
				{ children... }
			</main>
		</body>
	</html>
}
