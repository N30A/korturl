package pages

import "github.com/N30A/korturl/web/layouts"

css class() {
	display: flex;
	justify-content: center;
	text-align: center;
	padding-top: 15rem;
}

templ Error(title, message string) {
	@layouts.Base("Något gick fel") {
		<div class={ "container", class }>
			<hgroup>
				<h2>{ title }</h2>
				<p>{ message }</p>
			</hgroup>
		</div>
	}
}
